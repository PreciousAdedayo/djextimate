generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  category   String   @default("Music")
  readTime   String   @default("5 min read")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Track {
  id             String    @id @default(cuid())
  title          String
  artist         String    @default("DJ Extimate")
  featuredArtist String?
  coverImage     String?
  audioUrl       String?
  duration       String?
  releaseDate    DateTime?
  spotify        String?
  appleMusic     String?
  audiomack      String?
  youtube        String?
  published      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  venue       String?
  location    String?
  eventDate   DateTime
  description String?
  image       String?
  ticketUrl   String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  eventType String
  eventDate DateTime
  venue     String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}
